generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADJUSTER
  ADMIN
}

enum ClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  INVESTIGATION
  APPROVED
  REJECTED
  PAYMENT_PENDING
  PAID
  CLOSED
}

enum DocumentType {
  IDENTITY
  INVOICE
  POLICE_REPORT
  MEDICAL
  PHOTOGRAPH
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FraudRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FraudStatus {
  PENDING
  REVIEW
  FLAGGED
  CLEARED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

model User {
  id            String         @id @default(uuid())
  firstName     String
  lastName      String
  email         String         @unique
  phone         String
  role          UserRole       @default(CUSTOMER)
  passwordHash  String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  claims        Claim[]        @relation("ClaimCustomer")
  notifications Notification[] @relation("UserNotifications")

  @@map("users")
}

model Claim {
  id              String           @id @default(uuid())
  policyId        String
  customerId      String
  claimNumber     String           @unique
  status          ClaimStatus      @default(SUBMITTED)
  incidentDate    DateTime
  description     String
  claimAmount     Decimal          @db.Decimal(12, 2)
  approvedAmount  Decimal          @default(0.00) @db.Decimal(12, 2)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  customer        User             @relation("ClaimCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  documents       Document[]
  fraudAssessment FraudAssessment?
  payments        Payment[]

  @@index([customerId])
  @@index([claimNumber])
  @@index([status])
  @@map("claims")
}

model Document {
  id         String         @id @default(uuid())
  claimId    String
  name       String
  type       DocumentType
  url        String
  uploadedAt DateTime       @default(now())
  status     DocumentStatus @default(PENDING)
  claim      Claim          @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@map("documents")
}

model FraudAssessment {
  id          String         @id @default(uuid())
  claimId     String         @unique
  fraudScore  Int
  riskLevel   FraudRiskLevel
  riskFactors String[]       @default([])
  status      FraudStatus    @default(PENDING)
  claim       Claim          @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@map("fraud_assessments")
}

model Payment {
  id            String        @id @default(uuid())
  claimId       String
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  transactionId String
  createdAt     DateTime      @default(now())
  claim         Claim         @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@index([status])
  @@map("payments")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  type      NotificationType @default(INFO)
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@map("notifications")
}
